# Browser calls the same-origin proxy; no DB credentials or secret API tokens.
VITE_GRAPHQL_ENDPOINT=/api/olive/graphql
# Vite dev/preview proxy target. For local Olive: http://127.0.0.1:3001
OLIVE_API_ORIGIN=https://olive.codesquad.kr
VITE_SITE_URL=https://codesquad.kr
# Optional analytics; disabled when empty.
VITE_GA_MEASUREMENT_ID=
